# SMTP credentials for sending order confirmation emails (src/app/api/send-order-confirmation).
# This file is gitignored — never commit real credentials.
# Leave SMTP_HOST empty to skip sending (order still completes, email is just not sent).

SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for port 587/25 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional — defaults to SMTP_USER if left blank
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HoodiesHome

# Stripe keys — get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
